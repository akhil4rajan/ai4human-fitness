# Copy to .env. Nothing here is required for demo mode.

# --- App ---
APP_ENV=dev                      # shown in traces (dev|staging|prod)
APP_VERSION=0.1.0
LOG_LEVEL=INFO
CHAT_RATE_LIMIT_PER_MIN=20       # per client IP
TRUST_PROXY=0                    # 1 = trust X-Forwarded-For (only behind your own reverse proxy)
AI4HUMAN_FAKE_RUNNER=0           # 1 = canned answers, no API key or cost (demos/smoke tests)

# Users bring their own Anthropic key in the UI (Settings). To use one server-side key
# instead, set it here; the per-request key from the browser still takes precedence.
# ANTHROPIC_API_KEY=

# --- Langfuse (optional; tracing is off unless both keys are set) ---
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com   # or us./jp./hipaa. regions, or your self-hosted URL
# LANGFUSE_SAMPLE_RATE=1.0
# Message/answer/tool content is REDACTED from traces by default. Local debugging only:
# LANGFUSE_CAPTURE_CONTENT=1
